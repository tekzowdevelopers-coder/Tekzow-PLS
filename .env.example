# ==============================================================================
# Tekzow-PLS Environment Configuration (Vercel & Production Ready)
# ==============================================================================

# 1. DATABASE CONNECTION (Vercel Postgres / Neon / Supabase)
# For Vercel Postgres: Automatically populated when attaching a Vercel Postgres store.
# Format: postgresql://[user]:[password]@[host]:5432/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:password@ep-sample-host-pooler.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Unpooled direct connection (for Prisma migrations / direct Neon connection)
DATABASE_URL_UNPOOLED="postgresql://postgres:password@ep-sample-host.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# A strong random secret key (e.g. openssl rand -base64 32)
JWT_SECRET="generate-a-strong-random-32-char-secret-for-production"

# 3. APPLICATION BRANDING
NEXT_PUBLIC_APP_NAME="PyPractical"

# 4. PYTHON RUNTIME PATH
# Default on Vercel / Linux: python3
# Default on Windows: python
PYTHON_PATH="python3"
